set selection-clipboard clipboard

set adjust-open "width"

set scroll-step 50
set scroll-page-aware "true"

set synctex true
set synctex-editor-command "gvim --remote-silent +%{line} %{input}"

set font "monospace 10"

map i recolor

map z zoom in
map Z zoom out

map u scroll half-up
map d scroll half-down

unmap f
